# Salin berkas ini menjadi .env lalu sesuaikan nilainya.

APP_NAME=cli-system-blueprint
APP_VERSION=1.0.0
DEBUG=false

# Direktori tempat SQLite db, session state, dan hasil export disimpan
DATA_DIR=data

# Session
SESSION_FILE=session_state.json
SESSION_TTL_SECONDS=86400

# Cache
CACHE_MAX_ITEMS=256

# Graceful shutdown
SHUTDOWN_GRACE_PERIOD=2.0
