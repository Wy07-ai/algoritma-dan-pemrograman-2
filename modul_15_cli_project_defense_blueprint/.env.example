# .env.example — salin ke .env dan sesuaikan sebelum menjalankan aplikasi

# Metadata rilis (opsional, override nilai di config/release_settings.py)
APP_VERSION=1.0.0
APP_ENV=production

# Docker
DOCKER_IMAGE_NAME=cli-project-defense
DOCKER_IMAGE_TAG=1.0.0

# Demo
DEFAULT_DEMO_SCENARIO=quick_tour
DEMO_TYPE_SPEED=0.02
