# Salin berkas ini menjadi .env untuk mengubah konfigurasi audit

# Batas waktu eksekusi maksimum (milidetik) untuk fungsi tanpa SLA khusus
AUDIT_MAX_TIME_MS=500

# Batas alokasi memori maksimum (MB) untuk fungsi tanpa SLA khusus
AUDIT_MAX_MEMORY_MB=128

# Jumlah pengulangan tiap pengukuran (semakin besar = semakin stabil, semakin lambat)
AUDIT_REPEAT_COUNT=5

# Toleransi kenaikan memori antar-iterasi sebelum dicurigai sebagai leak (MB)
AUDIT_LEAK_TOLERANCE_MB=1.0

# Direktori keluaran laporan audit
AUDIT_REPORTS_DIR=audit_reports
